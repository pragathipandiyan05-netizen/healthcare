generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------
// Enums
// --------------------------------------------------

enum SosStatus {
  ACTIVE
  ACKNOWLEDGED
  ASSIGNED
  RESPONDING
  RESOLVED
  ESCALATED
  CANCELLED
}

enum SosPriority {
  CRITICAL
  HIGH
  NORMAL
}

enum InventoryStatus {
  AVAILABLE
  LOW
  OUT_OF_STOCK
  EXPIRED
}

enum EquipmentStatus {
  OPERATIONAL
  FAULT
  UNDER_MAINTENANCE
  RETIRED
}

enum NotificationLevel {
  CRITICAL
  HIGH
  MEDIUM
  INFO
}

// --------------------------------------------------
// Identity & RBAC
// --------------------------------------------------

model User {
  id            String   @id @default(uuid()) @db.Uuid
  employee_id   String   @unique
  name          String
  email         String   @unique
  phone         String?
  password_hash String
  status        String   @default("ACTIVE") // ACTIVE, DISABLED
  
  role_id       String   @db.Uuid
  role          Role     @relation(fields: [role_id], references: [id])
  
  hospital_id   String?  @db.Uuid
  hospital      Hospital? @relation(fields: [hospital_id], references: [id])
  
  district_id   String?  @db.Uuid
  district      District? @relation(fields: [district_id], references: [id])
  
  department_id String?  @db.Uuid
  department    Department? @relation(fields: [department_id], references: [id])
  
  last_login    DateTime? @db.Timestamptz

  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  // Relations
  sos_alerts_triggered SosAlert[] @relation("TriggeredSos")
  sos_alerts_acked     SosAlert[] @relation("AckedSos")
  sos_alerts_assigned  SosAlert[] @relation("AssignedSos")
  sos_alerts_resolved  SosAlert[] @relation("ResolvedSos")
  refresh_tokens       RefreshToken[]
  sessions             Session[]
  audit_logs           AuditLog[]

  @@index([email])
  @@index([hospital_id])
  @@index([district_id])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // e.g. SUPER_ADMIN, STATE_ADMIN
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  action      String   // e.g. "create", "read", "update", "delete"
  resource    String   // e.g. "SosAlert", "Worker", "Hospital"
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz

  role_permissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid
  
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

// --------------------------------------------------
// Auth Management
// --------------------------------------------------

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("refresh_tokens")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ip_address   String?
  user_agent   String?
  last_active  DateTime @default(now()) @db.Timestamptz
  created_at   DateTime @default(now()) @db.Timestamptz

  @@map("sessions")
}

// --------------------------------------------------
// Facilities
// --------------------------------------------------

model District {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  status     String   @default("ACTIVE")
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  hospitals  Hospital[]
  users      User[]
  sos_alerts SosAlert[]

  @@map("districts")
}

model Hospital {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  hospital_code String   @unique
  type          String   // Government, Private, etc.
  address       String
  phone         String?
  email         String?
  latitude      Decimal? @db.Decimal(10, 6)
  longitude     Decimal? @db.Decimal(10, 6)
  status        String   @default("ONLINE") // ONLINE, OFFLINE
  
  district_id   String   @db.Uuid
  district      District @relation(fields: [district_id], references: [id])
  
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  departments      Department[]
  users            User[]
  sos_alerts       SosAlert[]
  inventory_items  InventoryItem[]
  blood_banks      BloodBank[]
  equipment        Equipment[]

  @@map("hospitals")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  hospital_id String   @db.Uuid
  hospital    Hospital @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  users       User[]
  sos_alerts  SosAlert[]
  equipment   Equipment[]

  @@unique([name, hospital_id])
  @@map("departments")
}

// --------------------------------------------------
// SOS System
// --------------------------------------------------

model SosAlert {
  id              String   @id @default(uuid()) @db.Uuid
  
  worker_id       String   @db.Uuid
  worker          User     @relation("TriggeredSos", fields: [worker_id], references: [id])
  
  hospital_id     String   @db.Uuid
  hospital        Hospital @relation(fields: [hospital_id], references: [id])
  
  district_id     String   @db.Uuid
  district        District @relation(fields: [district_id], references: [id])
  
  department_id   String?  @db.Uuid
  department      Department? @relation(fields: [department_id], references: [id])
  
  latitude        Decimal? @db.Decimal(10, 6)
  longitude       Decimal? @db.Decimal(10, 6)
  
  status          SosStatus @default(ACTIVE)
  priority        SosPriority @default(CRITICAL)
  
  triggered_at    DateTime @default(now()) @db.Timestamptz
  acknowledged_at DateTime? @db.Timestamptz
  assigned_at     DateTime? @db.Timestamptz
  resolved_at     DateTime? @db.Timestamptz
  
  acknowledged_by String?  @db.Uuid
  ack_user        User?    @relation("AckedSos", fields: [acknowledged_by], references: [id])
  
  assigned_to     String?  @db.Uuid
  assigned_user   User?    @relation("AssignedSos", fields: [assigned_to], references: [id])
  
  resolved_by     String?  @db.Uuid
  res_user        User?    @relation("ResolvedSos", fields: [resolved_by], references: [id])
  
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  events          AlertEvent[]

  @@index([status])
  @@index([hospital_id])
  @@index([triggered_at])
  @@map("sos_alerts")
}

model AlertEvent {
  id           String   @id @default(uuid()) @db.Uuid
  sos_alert_id String   @db.Uuid
  sos_alert    SosAlert @relation(fields: [sos_alert_id], references: [id], onDelete: Cascade)
  
  event_type   String   // CREATED, ACKNOWLEDGED, ASSIGNED, ESCALATED, RESOLVED
  details      String?
  created_at   DateTime @default(now()) @db.Timestamptz

  @@map("alert_events")
}

// --------------------------------------------------
// Inventory
// --------------------------------------------------

model InventoryItem {
  id            String   @id @default(uuid()) @db.Uuid
  item_name     String
  category      String
  hospital_id   String   @db.Uuid
  hospital      Hospital @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  quantity      Int
  unit          String
  minimum_stock Int
  maximum_stock Int
  status        InventoryStatus @default(AVAILABLE)
  last_updated  DateTime @default(now()) @db.Timestamptz
  
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  alerts        InventoryAlert[]

  @@map("inventory_items")
}

model InventoryAlert {
  id            String   @id @default(uuid()) @db.Uuid
  item_id       String   @db.Uuid
  item          InventoryItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  status        InventoryStatus
  resolved_at   DateTime? @db.Timestamptz
  created_at    DateTime @default(now()) @db.Timestamptz

  @@index([status])
  @@map("inventory_alerts")
}

// --------------------------------------------------
// Blood Bank
// --------------------------------------------------

model BloodBank {
  id          String   @id @default(uuid()) @db.Uuid
  hospital_id String   @unique @db.Uuid
  hospital    Hospital @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  inventory   BloodInventory[]
  requests    BloodRequest[]

  @@map("blood_banks")
}

model BloodInventory {
  id               String   @id @default(uuid()) @db.Uuid
  blood_bank_id    String   @db.Uuid
  blood_bank       BloodBank @relation(fields: [blood_bank_id], references: [id], onDelete: Cascade)
  blood_group      String   // A+, A-, etc.
  component        String   // Whole Blood, RBC, Platelets, etc.
  available_units  Int
  minimum_required Int
  status           String   @default("AVAILABLE")
  last_updated     DateTime @default(now()) @db.Timestamptz
  
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  @@map("blood_inventory")
}

model BloodRequest {
  id            String   @id @default(uuid()) @db.Uuid
  blood_bank_id String   @db.Uuid
  blood_bank    BloodBank @relation(fields: [blood_bank_id], references: [id], onDelete: Cascade)
  blood_group   String
  component     String
  units_needed  Int
  urgency       String   // CRITICAL, HIGH, NORMAL
  status        String   @default("PENDING")
  
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  @@map("blood_requests")
}

// --------------------------------------------------
// Equipment
// --------------------------------------------------

model Equipment {
  id               String   @id @default(uuid()) @db.Uuid
  asset_id         String   @unique
  equipment_name   String
  hospital_id      String   @db.Uuid
  hospital         Hospital @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  department_id    String?  @db.Uuid
  department       Department? @relation(fields: [department_id], references: [id])
  
  status           EquipmentStatus @default(OPERATIONAL)
  last_maintenance DateTime? @db.Timestamptz
  next_maintenance DateTime? @db.Timestamptz
  assigned_tech_id String?  @db.Uuid // Refers to a User potentially
  
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  faults           EquipmentFault[]
  maintenance      EquipmentMaintenance[]

  @@map("equipment")
}

model EquipmentFault {
  id            String   @id @default(uuid()) @db.Uuid
  equipment_id  String   @db.Uuid
  equipment     Equipment @relation(fields: [equipment_id], references: [id], onDelete: Cascade)
  description   String
  reported_by   String   @db.Uuid
  status        String   @default("OPEN")
  resolved_at   DateTime? @db.Timestamptz
  
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  @@map("equipment_faults")
}

model EquipmentMaintenance {
  id            String   @id @default(uuid()) @db.Uuid
  equipment_id  String   @db.Uuid
  equipment     Equipment @relation(fields: [equipment_id], references: [id], onDelete: Cascade)
  performed_at  DateTime @db.Timestamptz
  notes         String?
  technician_id String   @db.Uuid
  
  created_at    DateTime @default(now()) @db.Timestamptz

  @@map("equipment_maintenance")
}

// --------------------------------------------------
// System Logs & Notifications
// --------------------------------------------------

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   // SOS, INVENTORY, BLOOD, EQUIPMENT, SYSTEM
  level       NotificationLevel @default(INFO)
  title       String
  message     String
  target_role String?  // Notify specific role
  target_user String?  @db.Uuid // Notify specific user
  read_at     DateTime? @db.Timestamptz
  
  created_at  DateTime @default(now()) @db.Timestamptz

  @@index([read_at])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actor_id    String?  @db.Uuid
  actor       User?    @relation(fields: [actor_id], references: [id])
  action      String   // e.g., "Worker created", "SOS assigned"
  entity_type String
  entity_id   String
  ip_address  String?
  user_agent  String?
  metadata    Json?    // Store before/after state
  
  created_at  DateTime @default(now()) @db.Timestamptz

  @@map("audit_logs")
}
